# URL of the FastAPI backend (backend/app.py).
# When set at build time, the app loads live data from the API and shows a
# "Live API" badge; when unset or unreachable, it falls back to bundled demo
# data so the static GitHub Pages build stays fully functional.
# Example: VITE_API_URL=http://localhost:8000
VITE_API_URL=

# Jambonz self-hosted telephony (optional — falls back to demo mode if unset)
JAMBONZ_API_URL=
JAMBONZ_API_KEY=
JAMBONZ_FROM_NUMBER=
